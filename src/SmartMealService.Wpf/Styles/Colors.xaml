<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ShellBackgroundColor">#F5FFC2</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PrimaryTextColor">#333333</Color>
    <Color x:Key="GridBorderColor">#383838</Color>
    <Color x:Key="GridLineColor">#7C7C7C</Color>
    <Color x:Key="ButtonHoverColor">#E8E8E8</Color>
    <Color x:Key="ShadowColor">#555555</Color>

    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{StaticResource ShellBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="GridBorderBrush" Color="{StaticResource GridBorderColor}" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
</ResourceDictionary>
