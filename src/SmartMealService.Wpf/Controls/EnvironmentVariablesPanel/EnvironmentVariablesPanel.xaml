<UserControl x:Class="SmartMealService.Wpf.Controls.EnvironmentVariablesPanel.EnvironmentVariablesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panel="clr-namespace:SmartMealService.Wpf.Controls.EnvironmentVariablesPanel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=panel:EnvironmentVariablesPanelViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartMealService.Wpf;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/SmartMealService.Wpf;component/Styles/Spacing.xaml" />
                <ResourceDictionary Source="/SmartMealService.Wpf;component/Styles/WindowStyles.xaml" />
                <ResourceDictionary Source="/SmartMealService.Wpf;component/Styles/DataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="24"
            Padding="{StaticResource ContentCardPadding}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              Direction="270"
                              Opacity="0.22"
                              ShadowDepth="7"
                              Color="{StaticResource ShadowColor}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Тестовое WPF-приложение для SmartMealService"
                           VerticalAlignment="Top"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Content="–"
                            Style="{StaticResource MinimizeButtonStyle}"
                            Click="MinimizeButton_Click" />
                    <Button Content="✕"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  SnapsToDevicePixels="True">
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="24" />

                <DataGrid Margin="3"
                          ItemsSource="{Binding EnvironmentVariables}"
                          Style="{StaticResource EnvironmentVariablesDataGridStyle}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Поле"
                                            Binding="{Binding Name}"
                                            IsReadOnly="True"
                                            Width="2*"
                                            ElementStyle="{StaticResource WrappedTextBlockStyle}" />
                        <DataGridTextColumn Header="Значение"
                                            Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                            Width="2*"
                                            ElementStyle="{StaticResource WrappedTextBlockStyle}"
                                            EditingElementStyle="{StaticResource ValueTextBoxStyle}" />
                        <DataGridTextColumn Header="Комментарий"
                                            Binding="{Binding Comment}"
                                            IsReadOnly="True"
                                            Width="3*"
                                            ElementStyle="{StaticResource WrappedTextBlockStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border BorderBrush="{StaticResource GridBorderBrush}"
                        BorderThickness="3"
                        CornerRadius="24"
                        IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
